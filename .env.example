# Server
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/teamkommit?replicaSet=rs0&directConnection=true
JWT_SECRET=dev-only-change-me
CORS_ORIGIN=http://localhost:5173

# S3-compatible object storage (s3mock locally via docker compose; MinIO/R2 in prod)
S3_ENDPOINT=http://127.0.0.1:9090
# Host used inside presigned URLs (must be reachable by the browser)
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9090
S3_REGION=us-east-1
S3_BUCKET=submissions
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Transactional email (Brevo). Leave empty to disable sending.
BREVO_API_KEY=
MAIL_FROM=noreply@teamkommit.dev
MAIL_FROM_NAME=TeamKommit
APP_URL=http://localhost:5173
BREVO_SMTP_USER=
